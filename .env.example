# COVID-19 tracker configuration (Create React App REACT_APP_* convention).
# Copy to `.env` and adjust as needed. All values are non-secret public URLs.

# Base URL for the totals / countries API. Trailing slash is optional.
# Leave unset to use the default (https://covid19.mathdro.id/api).
REACT_APP_API_BASE_URL=https://covid19.mathdro.id/api

# Optional live daily time-series source (JSON: a bare array or { data: [...] }).
# Leave EMPTY to render the line chart's graceful "No daily data available"
# empty state. The legacy https://api.covidtracking.com source was retired in
# 2021 and must not be used.
REACT_APP_DAILY_URL=
